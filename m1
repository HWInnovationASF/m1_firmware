#!/usr/bin/env bash
set -Eeuo pipefail

COMMAND="${1:-help}"
if (($#)); then shift; fi

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
INSTALLER_DIR="${M1_INSTALLER_DIR:-}"

has_installer_bundle() {
  [[ -f "$1/install.sh" && -f "$1/html.7z" && -f "$1/python.7z" ]]
}

if [[ -z "$INSTALLER_DIR" ]]; then
  runtime_user="${SUDO_USER:-${USER:-mdbcare}}"
  runtime_home="$(getent passwd "$runtime_user" 2>/dev/null | cut -d: -f6)"
  [[ -n "$runtime_home" ]] || runtime_home="/home/$runtime_user"
  for candidate in "$PWD" "$SELF_DIR" "$runtime_home/m1_firmware" /opt/mdbiot-installer; do
    if has_installer_bundle "$candidate"; then
      INSTALLER_DIR="$candidate"
      break
    fi
  done
  INSTALLER_DIR="${INSTALLER_DIR:-/opt/mdbiot-installer}"
fi

run_installer() {
  [[ -f "$INSTALLER_DIR/install.sh" ]] || { echo "install.sh not found in $INSTALLER_DIR" >&2; exit 1; }
  if [[ $EUID -eq 0 ]]; then exec env SOURCE_DIR="$INSTALLER_DIR" bash "$INSTALLER_DIR/install.sh" "$@"; fi
  exec sudo env SOURCE_DIR="$INSTALLER_DIR" bash "$INSTALLER_DIR/install.sh" "$@"
}

need_systemd() {
  command -v systemctl >/dev/null 2>&1 || { echo "systemd is unavailable. Run Python manually or enable systemd in WSL." >&2; exit 1; }
}

case "$COMMAND" in
  install) run_installer "$@" ;;
  update)
    git -C "$INSTALLER_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || { echo "Firmware repository not found. Set M1_INSTALLER_DIR or clone it to ~/m1_firmware." >&2; exit 1; }
    if [[ $EUID -eq 0 && -n "${SUDO_USER:-}" ]]; then sudo -u "$SUDO_USER" git -C "$INSTALLER_DIR" pull --ff-only; else git -C "$INSTALLER_DIR" pull --ff-only; fi
    echo "Latest files downloaded. Apply them with: sudo m1 install"
    ;;
  status) need_systemd; systemctl status py_multi.service --no-pager ;;
  restart) need_systemd; sudo systemctl restart py_multi.service; systemctl is-active py_multi.service ;;
  log) need_systemd; exec journalctl -u py_multi.service -f ;;
  logs) need_systemd; journalctl -u py_multi.service -n "${1:-100}" --no-pager ;;
  version) echo "MDBIoT M1 installer 20261029" ;;
  help|-h|--help)
    cat <<'EOF'
Usage: m1 {install|update|status|restart|log|logs [N]|version}

Examples:
  sudo m1 install --deploy-only --web-dir /var/www/html --python-dir /home/mdbcare/python
  sudo m1 install --full --web-server nginx --database mariadb
  m1 status
  m1 log                 # Follow live service log (Ctrl+C to stop)
  m1 logs 100            # Show the latest 100 service log lines
EOF
    ;;
  *) echo "Unknown command: $COMMAND" >&2; exit 2 ;;
esac
