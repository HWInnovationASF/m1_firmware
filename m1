#!/usr/bin/env bash
set -Eeuo pipefail

COMMAND="${1:-help}"
if (($#)); then shift; fi

SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
INSTALLER_DIR="${M1_INSTALLER_DIR:-/opt/mdbiot-installer}"
if [[ -f "$PWD/install.sh" && -f "$PWD/html.7z" && -f "$PWD/python.7z" ]]; then
  INSTALLER_DIR="$PWD"
elif [[ -f "$SELF_DIR/install.sh" && -f "$SELF_DIR/html.7z" && -f "$SELF_DIR/python.7z" ]]; then
  INSTALLER_DIR="$SELF_DIR"
else
  CALLING_USER="${SUDO_USER:-${USER:-}}"
  CALLING_HOME=""
  if [[ -n "$CALLING_USER" ]]; then
    CALLING_HOME="$(getent passwd "$CALLING_USER" 2>/dev/null | cut -d: -f6 || true)"
  fi
  if [[ -n "$CALLING_HOME" && -f "$CALLING_HOME/m1_firmware/install.sh" \
      && -f "$CALLING_HOME/m1_firmware/html.7z" \
      && -f "$CALLING_HOME/m1_firmware/python.7z" ]]; then
    INSTALLER_DIR="$CALLING_HOME/m1_firmware"
  fi
fi

run_installer() {
  [[ -f "$INSTALLER_DIR/install.sh" ]] || {
    echo "ไม่พบตัวติดตั้งที่ $INSTALLER_DIR/install.sh" >&2
    echo "กรุณาแตกไฟล์ชุดติดตั้ง แล้วเรียก sudo ./m1 install" >&2
    exit 1
  }
  if [[ $EUID -eq 0 ]]; then
    exec env SOURCE_DIR="$INSTALLER_DIR" bash "$INSTALLER_DIR/install.sh" "$@"
  fi
  exec sudo env SOURCE_DIR="$INSTALLER_DIR" bash "$INSTALLER_DIR/install.sh" "$@"
}

update_repository() {
  git -C "$INSTALLER_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    echo "ไม่พบ Git repository ที่ $INSTALLER_DIR" >&2
    echo "กรุณา cd เข้าโฟลเดอร์ m1_firmware แล้วเรียก m1 update" >&2
    exit 1
  }
  echo "==> Update firmware repository"
  if [[ $EUID -eq 0 && -n "${SUDO_USER:-}" && "$SUDO_USER" != "root" ]]; then
    sudo -u "$SUDO_USER" git -C "$INSTALLER_DIR" pull --ff-only
  else
    git -C "$INSTALLER_DIR" pull --ff-only
  fi
}

case "$COMMAND" in
  install)
    run_installer "$@"
    ;;
  update)
    update_repository
    if [[ $EUID -eq 0 ]]; then
      install -m 0755 "$INSTALLER_DIR/m1" /usr/local/bin/m1
    else
      sudo install -m 0755 "$INSTALLER_DIR/m1" /usr/local/bin/m1
    fi
    echo "อัปเดตไฟล์ Firmware เรียบร้อยแล้ว"
    echo "เมื่อต้องการติดตั้ง ให้เรียก: sudo m1 install"
    ;;
  status)
    systemctl status py_multi.service --no-pager
    ;;
  restart)
    if [[ $EUID -eq 0 ]]; then
      systemctl restart py_multi.service
    else
      sudo systemctl restart py_multi.service
    fi
    systemctl is-active py_multi.service
    ;;
  logs)
    journalctl -u py_multi.service -n "${1:-100}" --no-pager
    ;;
  version)
    echo "MDBIoT M1 installer 20260915"
    ;;
  help|-h|--help)
    cat <<'HELP'
Usage: m1 <command>

Commands:
  install   ติดตั้งหรืออัปเดต MDBIoT M1
  update    ดึงไฟล์ Firmware ล่าสุดด้วย git pull --ff-only (ยังไม่ติดตั้ง)
  status    แสดงสถานะ py_multi.service
  restart   เริ่ม py_multi.service ใหม่
  logs [N]  แสดง Log ล่าสุด (ค่าเริ่มต้น 100 บรรทัด)
  version   แสดงเวอร์ชันชุดติดตั้ง
HELP
    ;;
  *)
    echo "ไม่รู้จักคำสั่ง: $COMMAND" >&2
    echo "ใช้: m1 help" >&2
    exit 2
    ;;
esac
